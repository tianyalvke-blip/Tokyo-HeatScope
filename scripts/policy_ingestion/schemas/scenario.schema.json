{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.schema.json",
  "title": "Policy scenario",
  "type": "object",
  "required": ["scenario_id", "name_ja", "name_en", "characteristics", "problems", "recommended_interventions", "evidence_type", "extraction_confidence", "source_evidence"],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "name_ja": {"type": "string", "minLength": 1},
    "name_en": {"type": "string"},
    "characteristics": {"type": "array", "items": {"type": "string"}},
    "problems": {"type": "array", "items": {"type": "string"}},
    "recommended_interventions": {"type": "array", "items": {"type": "string"}},
    "evidence_type": {"const": "policy"},
    "extraction_confidence": {"enum": ["high", "medium", "low"]},
    "source_evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["document_id", "source_file", "page", "chapter", "section", "chunk_id"]}}
  },
  "additionalProperties": true
}

